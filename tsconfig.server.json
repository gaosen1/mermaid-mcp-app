{
  "compilerOptions": {
    "types": [
      "node"
    ],
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "server.ts",
    "main.ts",
    "config.ts",
    "mermaid-local.ts",
    "html-note.ts",
    "renders.ts",
    "bake.ts",
    "src/targets.ts",
    "src/content-type.ts"
  ]
}
